rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write access to all records, audit logs, and metadata
    match /records/{recordId} {
      allow read, write: if true;
    }
    match /audit/{auditId} {
      allow read, write: if true;
    }
    match /meta/{metaId} {
      allow read, write: if true;
    }
    
    // Catch-all fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
